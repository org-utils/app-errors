{
  "name": "@org-utils/errors",
  "version": "0.0.0",
  "description": "Framework-agnostic application and HTTP error primitives for Node.js and TypeScript applications.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "clean":"rimraf ./dist",
    "build:types": "tsup && tsc --emitDeclarationOnly",
    "build": "npm run clean && npm run build:types",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "changesets:init": "changeset init",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "release": "npm run pre-build && changeset publish"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
